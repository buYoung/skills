{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "hooks": {
    "after:bump": [
      "node scripts/release/bump-marketplace.js ${version}",
      "node scripts/release/write-changelog.js ${latestTag} ${version}"
    ]
  },
  "git": {
    "commitArgs": ["-a"],
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "push": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  }
}
