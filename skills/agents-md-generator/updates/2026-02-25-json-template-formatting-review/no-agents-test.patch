+    /**
+     * JSON 문자열 내의 템플릿 문법을 찾아 고유한 placeholder로 치환합니다.
+     * 이미 따옴표 내부에 있는 템플릿은 무시합니다.
+     *
+     * @param json 원본 JSON 문자열
+     * @return 치환된 JSON 문자열과 placeholder 맵의 Pair
+     */
+    private fun prepareJsonForFormatting(json: String): Pair<String, Map<String, String>> {
+        val placeholders = mutableMapOf<String, String>()
+        var counter = 0
+
+        val result = combinedTemplateRegex.replace(json) { matchResult ->
+            val stringLiteral = matchResult.groups[1]?.value
+            val template = matchResult.groups[3]?.value
+
+            if (stringLiteral != null) {
+                // 문자열 리터럴 내의 템플릿은 그대로 유지
+                stringLiteral
+            } else if (template != null) {
+                // 따옴표 밖의 템플릿은 placeholder로 치환하여 Jackson이 유효한 문자열 값으로 인식하게 함
+                val placeholder = "\"__JSONINJA_TEMPLATE_${counter++}__\""
+                placeholders[placeholder] = template
+                placeholder
+            } else {
+                matchResult.value
+            }
+        }
+
+        return Pair(result, placeholders)
+    }
+
+    /**
+     * placeholder를 원래의 템플릿 문법으로 복원합니다.
+     *
+     * @param json 포맷팅된 JSON 문자열
+     * @param placeholders placeholder 맵
+     * @return 템플릿이 복원된 JSON 문자열
+     */
+    private fun restoreTemplates(json: String, placeholders: Map<String, String>): String {
+        var result = json
+        placeholders.forEach { (placeholder, originalValue) ->
+            // Jackson이 포맷팅 시 placeholder를 포함한 문자열을 어떻게 처리했는지에 따라
+            // 정확한 매칭이 필요함. 여기서는 단순 replace를 사용.
+            result = result.replace(placeholder, originalValue)
+        }
+        return result
+    }
+
     /**
      * 커스텀 PrettyPrinter 클래스
      * JSON 포맷팅 시 사용되는 들여쓰기 및 출력 형식 정의
