+    fun testFormatJsonWithTemplate() {
+        // 1. Simple value template
+        val templateJson = """{ "test": {{.value}} }"""
+        val prettifiedJson = jsonFormatterService.formatJson(templateJson, JsonFormatState.PRETTIFY)
+
+        assertTrue("Should contain newline", prettifiedJson.contains("\n"))
+        assertTrue("Should contain value placeholder", prettifiedJson.contains("{{.value}}"))
+        assertEquals("{\n  \"test\": {{.value}}\n}", prettifiedJson)
+
+        // 2. Multiple templates and different styles
+        val multiTemplateJson = """{"a": {{val1}}, "b": "${'$'}{val2}", "c": "normal"}"""
+        val prettifiedMulti = jsonFormatterService.formatJson(multiTemplateJson, JsonFormatState.PRETTIFY)
+        assertTrue(prettifiedMulti.contains("{{val1}}"))
+        assertTrue(prettifiedMulti.contains("${'$'}{val2}"))
+
+        // 3. Template in key
+        val keyTemplateJson = """{ {{key}}: "value" }"""
+        val prettifiedKey = jsonFormatterService.formatJson(keyTemplateJson, JsonFormatState.PRETTIFY)
+        assertTrue(prettifiedKey.contains("{{key}}"))
+        assertTrue(prettifiedKey.contains("\"value\""))
+
+        // 4. Template inside string literal (should be preserved as-is)
+        val templateInString = """{ "url": "http://{{host}}/api" }"""
+        val prettifiedString = jsonFormatterService.formatJson(templateInString, JsonFormatState.PRETTIFY)
+        assertTrue(prettifiedString.contains("\"http://{{host}}/api\""))
+        // Check that it's not double-quoted or broken
+        assertFalse(prettifiedString.contains("\"\""))
+
+        // 5. Uglify with template
+        val uglyWithTemplate = """
+            {
+              "test": {{.value}}
+            }
+        """.trimIndent()
+        val uglified = jsonFormatterService.formatJson(uglyWithTemplate, JsonFormatState.UGLIFY)
+        assertEquals("""{"test":{{.value}}}""", uglified)
+    }
+
+    fun testIsValidJsonWithTemplate() {
+        // Test with template syntax
+        val templateJson = """{ "test": {{.value}} }"""
+        assertTrue("Should be valid even with template syntax", jsonFormatterService.isValidJson(templateJson))
+
+        val multiTemplateJson = """{"a": {{val1}}, "b": "${'$'}{val2}", "c": "normal"}"""
+        assertTrue("Should be valid with multiple template styles", jsonFormatterService.isValidJson(multiTemplateJson))
+
+        val keyTemplateJson = """{ {{key}}: "value" }"""
+        assertTrue("Should be valid with template in key", jsonFormatterService.isValidJson(keyTemplateJson))
+    }
