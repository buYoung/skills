+    private fun replaceTemplates(json: String): Pair<String, Map<String, String>> {
+        val templates = mutableMapOf<String, String>()
+        var counter = 0
+        val replaced = templateRegex.replace(json) { matchResult ->
+            val stringLiteral = matchResult.groups[1]
+            if (stringLiteral != null) {
+                // 문자열 리터럴은 그대로 유지
+                stringLiteral.value
+            } else {
+                // 템플릿 문법은 플레이스홀더로 치환
+                val template = matchResult.groups[2]!!.value
+                val placeholder = "\"__JSONINJA_TEMPLATE_${counter++}__\""
+                templates[placeholder] = template
+                placeholder
+            }
+        }
+        return Pair(replaced, templates)
+    }
+
+    private fun restoreTemplates(json: String, templates: Map<String, String>): String {
+        var restored = json
+        templates.forEach { (placeholder, original) ->
+            restored = restored.replace(placeholder, original)
+        }
+        return restored
+    }
