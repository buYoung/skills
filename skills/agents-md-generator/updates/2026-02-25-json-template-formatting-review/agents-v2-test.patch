+        // Template syntax pattern (e.g., {{.value}}) - only match when NOT surrounded by quotes
+        private val TEMPLATE_PATTERN = Regex("""(?<!")\{\{[^{}]+\}\}(?!")""")
+        private const val TEMPLATE_PLACEHOLDER_PREFIX = "___JSONINJA_TEMPLATE_"
+        private const val TEMPLATE_PLACEHOLDER_SUFFIX = "___"
+    }
+
+    /**
+     * 템플릿 문법({{.value}})을 임시 플레이스홀더로 치환
+     */
+    private fun replaceTemplates(json: String): Pair<String, Map<String, String>> {
+        val templateMap = mutableMapOf<String, String>()
+        var counter = 0
+
+        val replacedJson = TEMPLATE_PATTERN.replace(json) { matchResult ->
+            // Wrap the placeholder in quotes so it's a valid JSON string value
+            val placeholder = "$TEMPLATE_PLACEHOLDER_PREFIX${counter++}$TEMPLATE_PLACEHOLDER_SUFFIX"
+            val quotedPlaceholder = "\"$placeholder\""
+            templateMap[quotedPlaceholder] = matchResult.value
+            quotedPlaceholder
+        }
+
+        return Pair(replacedJson, templateMap)
+    }
+
+    /**
+     * 플레이스홀더를 다시 원래의 템플릿 문법으로 원복
+     */
+    private fun restoreTemplates(json: String, templateMap: Map<String, String>): String {
+        var restoredJson = json
+        templateMap.forEach { (placeholder, original) ->
+            restoredJson = restoredJson.replace(placeholder, original)
+        }
+        return restoredJson
     }
 
 
