+    fun testFormatJsonWithTemplateSyntax() {
+        // Test with template syntax {{.value}}
+        val jsonWithTemplate = """{"test": {{.value}}}"""
+
+        // This should be considered valid for our purposes or handled by the formatter
+        // Currently it might fail isValidJson, so we need to fix that too if we want it to be formatted
+
+        val prettified = jsonFormatterService.formatJson(jsonWithTemplate, JsonFormatState.PRETTIFY)
+
+        // If it's formatted, it should look like:
+        // {
+        //   "test": {{.value}}
+        // }
+        // (depending on indent settings)
+
+        assertTrue("Formatted JSON should contain the template syntax", prettified.contains("{{.value}}"))
+        assertTrue("Formatted JSON should be pretty printed", prettified.contains("\n"))
+
+        val uglified = jsonFormatterService.formatJson(jsonWithTemplate, JsonFormatState.UGLIFY)
+        assertEquals("""{"test":{{.value}}}""", uglified.replace(" ", ""))
+    }
+
+    fun testFormatJsonWithComplexTemplateSyntax() {
+        val complexJson = """
+            {
+                "key1": {{.val1}},
+                {{.key2}}: "val2",
+                "nested": {
+                    "inner": {{.val3}}
+                },
+                "array": [{{.val4}}, {{.val5}}],
+                "alreadyQuoted": "{{.val6}}"
+            }
+        """.trimIndent()
+
+        assertTrue(
+            "Should be considered valid JSON with our template handling",
+            jsonFormatterService.isValidJson(complexJson)
+        )
+
+        val formatted = jsonFormatterService.formatJson(complexJson, JsonFormatState.PRETTIFY)
+
+        assertTrue(formatted.contains("\"key1\": {{.val1}}"))
+        assertTrue(formatted.contains("{{.key2}}: \"val2\""))
+        assertTrue(formatted.contains("\"inner\": {{.val3}}"))
+        assertTrue(formatted.contains("{{.val4}}"))
+        assertTrue(formatted.contains("{{.val5}}"))
+        assertTrue(formatted.contains("\"alreadyQuoted\": \"{{.val6}}\""))
+    }
+
+    fun testFormatJsonWithSortedTemplates() {
+        val json = """
+            {
+                "z": 1,
+                "{{.a_key}}": 2,
+                "b": 3
+            }
+        """.trimIndent()
+
+        // Note: Our current TEMPLATE_PATTERN (?<!")\{\{[^{}]+\}\}(?!") 
+        // will NOT match "{{.a_key}}" because it HAS quotes.
+        // This is fine as it's already valid JSON.
+
+        val sorted = jsonFormatterService.formatJson(json, JsonFormatState.PRETTIFY_SORTED)
+
+        // Expected order: b, z, {{.a_key}} (since { comes after letters) or something similar
+        // The important part is that {{.a_key}} is preserved.
+        assertTrue("Should preserve template key when sorting", sorted.contains("{{.a_key}}"))
+
+        val jsonNoQuotes = """
+            {
+                "z": 1,
+                {{.a_key}}: 2,
+                "b": 3
+            }
+        """.trimIndent()
+
+        val sortedNoQuotes = jsonFormatterService.formatJson(jsonNoQuotes, JsonFormatState.PRETTIFY_SORTED)
+        assertTrue("Should preserve unquoted template key when sorting", sortedNoQuotes.contains("{{.a_key}}"))
+    }
 }
