+package com.livteam.jsoninja.services
+
+import com.intellij.testFramework.fixtures.BasePlatformTestCase
+import com.livteam.jsoninja.model.JsonFormatState
+
+class JsonFormatterTemplateTest : BasePlatformTestCase() {
+    private lateinit var jsonFormatterService: JsonFormatterService
+
+    override fun setUp() {
+        super.setUp()
+        jsonFormatterService = JsonFormatterService(project)
+    }
+
+    fun testFormatJsonWithTemplate() {
+        val jsonWithTemplate = """{  "test": {{.value}} }"""
+        val prettifiedJson = jsonFormatterService.formatJson(jsonWithTemplate, JsonFormatState.PRETTIFY)
+
+        assertTrue("Prettified JSON should contain newline", prettifiedJson.contains("\n"))
+        assertTrue("Prettified JSON should contain template", prettifiedJson.contains("{{.value}}"))
+        assertTrue("Prettified JSON should have property test", prettifiedJson.contains("\"test\""))
+        assertEquals(
+            """{
+  "test": {{.value}}
+}""", prettifiedJson.trim()
+        )
+    }
+
+    fun testFormatJsonWithTemplateKey() {
+        val jsonWithTemplateKey = """{ {{.key}}: "value" }"""
+        val prettifiedJson = jsonFormatterService.formatJson(jsonWithTemplateKey, JsonFormatState.PRETTIFY)
+
+        assertTrue(prettifiedJson.contains("\n"))
+        assertTrue(prettifiedJson.contains("{{.key}}"))
+        assertEquals(
+            """{
+  {{.key}}: "value"
+}""", prettifiedJson.trim()
+        )
+    }
+
+    fun testFormatJsonWithMixedTemplates() {
+        val json = """{"a":{{.a}},"b":"static {{.b}}","c":{{.c}}}"""
+        val prettifiedJson = jsonFormatterService.formatJson(json, JsonFormatState.PRETTIFY)
+
+        assertTrue(prettifiedJson.contains("\"a\": {{.a}}"))
+        assertTrue(prettifiedJson.contains("\"b\": \"static {{.b}}\""))
+        assertTrue(prettifiedJson.contains("\"c\": {{.c}}"))
+    }
+
+    fun testFormatJsonWithTemplateInTemplate() {
+        // Nested curly braces in template
+        val json = """{"test": {{.value { "foo": "bar" } }} }"""
+        val prettifiedJson = jsonFormatterService.formatJson(json, JsonFormatState.PRETTIFY)
+
+        assertTrue(prettifiedJson.contains("{{.value { \"foo\": \"bar\" } }}"))
+    }
+
+    fun testIsValidJsonWithTemplate() {
+        val jsonWithTemplate = """{ "test": {{.value}} }"""
+        assertTrue("Should be valid JSON with template", jsonFormatterService.isValidJson(jsonWithTemplate))
+
+        val invalidJsonWithTemplate = """{ "test": {{.value} }""" // Missing one }
+        assertFalse(
+            "Should be invalid JSON with broken template",
+            jsonFormatterService.isValidJson(invalidJsonWithTemplate)
+        )
+    }
+}
