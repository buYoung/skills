+    private val templateRegex = Regex("""\{\{.*?\}\}""")
+
+    /**
+     * 템플릿 문법({{...}})을 고유한 플레이스홀더로 치환
+     *
+     * @param json 원본 JSON 문자열
+     * @return 치환된 JSON 문자열과 플레이스홀더 맵의 Pair
+     */
+    private fun replaceTemplates(json: String): Pair<String, Map<String, String>> {
+        if (!json.contains("{{")) return json to emptyMap()
+
+        val templates = mutableMapOf<String, String>()
+        var count = 0
+
+        // 1. 모든 {{...}}를 임시 식별자로 치환
+        val intermediate = templateRegex.replace(json) { matchResult ->
+            val placeholder = "__JNJ_TPL_${count++}__"
+            templates[placeholder] = matchResult.value
+            placeholder
+        }
+
+        // 2. 따옴표 없이 사용된 식별자들에 따옴표를 씌워 유효한 JSON으로 만듦
+        // 이때 식별자 이름을 변경하여 나중에 복구할 때 구분할 수 있게 함
+        var finalJson = intermediate
+        val finalTemplates = mutableMapOf<String, String>()
+
+        templates.forEach { (placeholder, original) ->
+            val quotePattern = Regex("""(?<!["'])$placeholder(?!["'])""")
+            if (quotePattern.containsMatchIn(finalJson)) {
+                val quotedPlaceholder = placeholder.replace("_TPL_", "_TPL_Q_")
+                finalJson = finalJson.replace(quotePattern, "\"$quotedPlaceholder\"")
+                finalTemplates[quotedPlaceholder] = original
+            } else {
+                finalTemplates[placeholder] = original
+            }
+        }
+
+        return finalJson to finalTemplates
+    }
+
+    /**
+     * 플레이스홀더를 다시 원래의 템플릿 문법으로 복구
+     *
+     * @param json 포맷팅된 JSON 문자열
+     * @param templates 플레이스홀더 맵
+     * @return 복구된 JSON 문자열
+     */
+    private fun restoreTemplates(json: String, templates: Map<String, String>): String {
+        if (templates.isEmpty()) return json
+        var restored = json
+
+        val sortedPlaceholders = templates.keys.sortedByDescending { it.length }
+
+        sortedPlaceholders.forEach { placeholder ->
+            val original = templates[placeholder] ?: return@forEach
+            if (placeholder.contains("_TPL_Q_")) {
+                // 따옴표와 함께 치환된 플레이스홀더 복구 (따옴표 제거)
+                restored = restored.replace("\"$placeholder\"", original)
+            } else {
+                // 문자열 내부 등에 따옴표 없이 치환된 플레이스홀더 복구
+                restored = restored.replace(placeholder, original)
+            }
+        }
+        return restored
+    }
+
