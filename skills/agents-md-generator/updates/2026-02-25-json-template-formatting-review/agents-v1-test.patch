+package com.livteam.jsoninja.services
+
+import com.intellij.testFramework.fixtures.BasePlatformTestCase
+import com.livteam.jsoninja.model.JsonFormatState
+
+class JsonTemplateFormatTest : BasePlatformTestCase() {
+    private lateinit var jsonFormatterService: JsonFormatterService
+
+    override fun setUp() {
+        super.setUp()
+        jsonFormatterService = JsonFormatterService(project)
+    }
+
+    fun testFormatJsonWithGoTemplate() {
+        val jsonWithTemplate = """{ "test": {{.value}} }"""
+        val formatted = jsonFormatterService.formatJson(jsonWithTemplate, JsonFormatState.PRETTIFY)
+
+        // 현재는 isValidJson이 false를 반환하여 원본이 그대로 나올 것으로 예상됨
+        // 하지만 목표는 포맷팅이 되는 것
+        val expected = """{
+  "test": {{.value}}
+}"""
+        assertEquals(expected, formatted)
+    }
+
+    fun testFormatJsonWithMultipleTemplates() {
+        val jsonWithTemplates = """{"key": {{.val}}, "list": [{{.item1}}, {{.item2}}], {{.dynamicKey}}: "value"}"""
+        val formatted = jsonFormatterService.formatJson(jsonWithTemplates, JsonFormatState.PRETTIFY)
+
+        val expected = """{
+  "key": {{.val}},
+  "list": [
+    {{.item1}},
+    {{.item2}}
+  ],
+  {{.dynamicKey}}: "value"
+}"""
+        assertEquals(expected, formatted)
+    }
+
+    fun testFormatJsonWithQuotedTemplate() {
+        val jsonWithQuotedTemplate = """{ "test": "{{.value}}" }"""
+        val formatted = jsonFormatterService.formatJson(jsonWithQuotedTemplate, JsonFormatState.PRETTIFY)
+
+        val expected = """{
+  "test": "{{.value}}"
+}"""
+        assertEquals(expected, formatted)
+    }
+
+    fun testFormatJsonWithTemplateInsideSpace() {
+        val jsonWithTemplateAndSpace = """{ "test": {{ .value }} }"""
+        val formatted = jsonFormatterService.formatJson(jsonWithTemplateAndSpace, JsonFormatState.PRETTIFY)
+
+        val expected = """{
+  "test": {{ .value }}
+}"""
+        assertEquals(expected, formatted)
+    }
+
+    fun testFormatJsonWithMixedTemplates() {
+        val mixedJson = """{ "unquoted": {{.val1}}, "quoted": "{{.val2}}", "key_{{.id}}": "value" }"""
+        val formatted = jsonFormatterService.formatJson(mixedJson, JsonFormatState.PRETTIFY)
+
+        val expected = """{
+  "unquoted": {{.val1}},
+  "quoted": "{{.val2}}",
+  "key_{{.id}}": "value"
+}"""
+        // "key_{{.id}}" 이 부분도 이제 잘 지원됩니다.
+        // "{{.id}}" 부분이 임시 식별자로 치환되었다가 다시 복구됩니다.
+
+        // 예시에서 요구한 `{ "test": {{.value}} }`와 같은 형태를 포함하여 다양한 템플릿 문법이 잘 동작합니다.
+        assertEquals(expected, formatted)
+    }
+}
